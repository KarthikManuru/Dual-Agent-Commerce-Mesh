# ==========================================================
# Dual-Agent Commerce Mesh — Environment Variables
# Copy to .env and fill in real values
# ==========================================================

# Database (Railway auto-provides DATABASE_URL for its Postgres plugin)
DATABASE_URL=postgresql+asyncpg://mesh:meshdev@localhost:5432/commerce_mesh
DATABASE_URL_SYNC=postgresql+psycopg2://mesh:meshdev@localhost:5432/commerce_mesh

# Redis (Railway auto-provides REDIS_URL for its Redis plugin)
REDIS_URL=redis://localhost:6379/0

# Razorpay Test Mode Keys (get from https://dashboard.razorpay.com/app/keys)
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXX
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# AI / LLM
LLM_REQUIRED=true
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=

# App
APP_ENV=production
DEBUG=false
DEFAULT_LLM_MODEL=gemini-2.5-flash

# CORS — comma-separated allowed origins for the backend
# Add your Vercel frontend domain here after deploying
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Port (Railway injects PORT automatically — do not hardcode)
PORT=8000

# Frontend environment variables (set in Vercel project settings)
# NEXT_PUBLIC_API_URL=https://your-railway-backend.up.railway.app
# NEXT_PUBLIC_WS_URL=wss://your-railway-backend.up.railway.app/ws/orders
